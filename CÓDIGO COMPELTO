  .settings-nav-item.active { background: var(--red-pale); color: var(--red-primary); font-weight: 600; }
  .settings-nav-item svg { width: 16px; height: 16px; stroke: currentColor; fill: none; }

  .settings-panel { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; }

  .settings-section { margin-bottom: 28px; }
  .settings-section:last-child { margin-bottom: 0; }
  .settings-section h3 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .settings-section p { font-size: 12px; color: var(--gray-400); margin-bottom: 16px; }

  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--gray-100);
  }

  .toggle-row:last-child { border-bottom: none; }
  .toggle-label { font-size: 13px; font-weight: 500; }
  .toggle-sub { font-size: 12px; color: var(--gray-400); }

  .toggle {
    width: 40px;
    height: 22px;
    background: var(--gray-200);
    border-radius: 99px;
    cursor: pointer;
    transition: background .2s;
    position: relative;
    flex-shrink: 0;
  }

  .toggle.on { background: var(--red-primary); }

  .toggle::after {
    content: '';
    position: absolute;
    top: 3px; left: 3px;
    width: 16px; height: 16px;
    background: white;
    border-radius: 50%;
    transition: transform .2s;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
  }

  .toggle.on::after { transform: translateX(18px); }

  /* ─── PAGINATION ─── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-top: 1px solid var(--gray-100);
  }

  .page-info { font-size: 12px; color: var(--gray-400); }

  .page-btns { display: flex; gap: 4px; }

  .page-btn {
    width: 30px; height: 30px;
    border: 1.5px solid var(--gray-200);
    border-radius: 6px;
    background: var(--white);
    font-size: 12px;
    font-weight: 500;
    color: var(--gray-500);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .15s;
  }

  .page-btn:hover { border-color: var(--red-primary); color: var(--red-primary); }
  .page-btn.active { background: var(--red-primary); border-color: var(--red-primary); color: white; }
  .page-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; }

  /* ─── TOAST ─── */
  .toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 999;
  }

  .toast {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: var(--shadow-lg);
    animation: toast-in .3s ease;
    min-width: 260px;
  }

  @keyframes toast-in {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  .toast-success { background: var(--green); color: white; }
  .toast-error { background: var(--red-primary); color: white; }
  .toast-info { background: var(--gray-900); color: white; }
  .toast svg { width: 16px; height: 16px; stroke: currentColor; fill: none; }

  /* ─── ACCESS LOG ─── */
  .log-filters {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .log-filter {
    padding: 6px 12px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid var(--gray-200);
    background: var(--white);
    color: var(--gray-500);
    transition: all .15s;
  }

  .log-filter.active { background: var(--red-primary); border-color: var(--red-primary); color: white; }
  .log-filter:hover:not(.active) { border-color: var(--red-primary); color: var(--red-primary); }

  .full-width { grid-column: 1 / -1; }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .page-header h2 { font-size: 18px; font-weight: 700; }
  .page-header p { font-size: 13px; color: var(--gray-400); margin-top: 3px; }

  .alert-bar {
    background: var(--amber-light);
    border: 1px solid #FDE68A;
    border-radius: 10px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--amber);
    font-weight: 500;
  }

  .alert-bar svg { width: 18px; height: 18px; stroke: currentColor; fill: none; flex-shrink: 0; }
</style>
