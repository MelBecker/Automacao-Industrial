<!-- TOAST CONTAINER -->
<div class="toast-container" id="toasts"></div>

<script>
// ─── DATA ───
const people = [
  { nome: 'Guilherme', doc: '125034439', tipo: 'Aluno', turma: '3º A', entrada: '14:25', saida: '—', status: 'presente' },
  { nome: 'Mariana', doc: 'RA-2024-881', tipo: 'Aluno', turma: '3º A', entrada: '14:24', saida: '—', status: 'presente' },
  { nome: 'Mel', doc: 'RA-2024-345', tipo: 'Aluno', turma: '3º A', entrada: '14:23', saida: '—', status: 'presente' },
  { nome: 'Gabriel', doc: 'RA-2023-099', tipo: 'Aluno', turma: '3º A', entrada: '14:22', saida: '—', status: 'presente' },
  { nome: 'Melissa', doc: 'RA-2024-211', tipo: 'Aluno', turma: '3º A', entrada: '14:21', saida: '14:50', status: 'saiu' },
  { nome: 'João F.', doc: 'RA-2023-774', tipo: 'Aluno', turma: '3º A', entrada: '14:20', saida: '14:45', status: 'saiu' },
  { nome: 'Prof. Ana', doc: 'FP-004', tipo: 'Funcionário', turma: 'Sala 101', entrada: '07:30', saida: '—', status: 'presente' },
  { nome: 'Carlos R.', doc: '987654321', tipo: 'Aluno', turma: '2º B', entrada: '13:55', saida: '—', status: 'presente' },
  { nome: 'Desconhecido', doc: '—', tipo: '—', turma: '—', entrada: '13:40', saida: '—', status: 'negado' },
  { nome: 'Sandra Lima', doc: 'VIS-089', tipo: 'Visitante', turma: 'Diretoria', entrada: '10:00', saida: '—', status: 'presente' },
];

const visitors = [
  { nome: 'Roberto Alves', doc: '321.654.987-00', destino: 'Diretoria', resp: 'Dir. Fernanda', entrada: '09:10', status: 'no local' },
  { nome: 'Camila Torres', doc: '456.789.123-00', destino: 'Sala 203', resp: 'Prof. André', entrada: '10:30', status: 'no local' },
  { nome: 'Felipe Nunes', doc: '789.123.456-00', destino: 'Secretaria', resp: 'Fernanda M.', entrada: '08:00', status: 'saiu' },
  { nome: 'Sandra Lima', doc: '234.567.890-00', destino: 'Diretoria', resp: 'Dir. Fernanda', entrada: '10:00', status: 'no local' },
];

const scanNames = [
  { nome: 'Lucas Andrade', info: 'Aluno — 2º B • ID 2023-112' },
  { nome: 'Fernanda Costa', info: 'Funcionário — Secretaria • ID FP-009' },
  { nome: 'Rafael Souza', info: 'Aluno — 1º A • ID 2024-457' },
  { nome: 'Beatriz Melo', info: 'Aluno — 3º B • ID 2024-033' },
];

let scanIdx = 0;
let scanState = 'idle';

// ─── RENDER TABLES ───
function statusBadge(s) {
  const map = {
    presente: `<span class="badge badge-green"><span class="badge-dot"></span>Presente</span>`,
    saiu: `<span class="badge badge-gray"><span class="badge-dot"></span>Saiu</span>`,
    negado: `<span class="badge badge-red"><span class="badge-dot"></span>Negado</span>`,
    'no local': `<span class="badge badge-green"><span class="badge-dot"></span>No local</span>`,
  };
  return map[s] || `<span class="badge badge-gray">${s}</span>`;
}

function renderDashboard() {
  const tb = document.getElementById('dashboard-table');
  tb.innerHTML = people.slice(0,8).map(p => `
    <tr>
      <td class="td-name">${p.nome}</td>
      <td>${p.doc}</td>
      <td><span class="badge ${p.tipo==='Aluno'?'badge-blue':p.tipo==='Funcionário'?'badge-amber':'badge-gray'}">${p.tipo}</span></td>
      <td>${p.turma}</td>
      <td>${p.entrada}</td>
      <td>${p.status==='negado'?'<span style="color:var(--red-primary);font-weight:600">—</span>':p.saida}</td>
      <td>${statusBadge(p.status)}</td>
    </tr>
  `).join('');
}

function renderAcessos() {
  const tb = document.getElementById('acessos-table');
  tb.innerHTML = people.map(p => `
    <tr>
      <td class="td-name">${p.nome}</td>
      <td>${p.doc}</td>
      <td><span class="badge ${p.tipo==='Aluno'?'badge-blue':p.tipo==='Funcionário'?'badge-amber':'badge-gray'}">${p.tipo}</span></td>
      <td>${p.turma}</td>
      <td>${p.entrada}</td>
      <td>${p.saida}</td>
      <td>${statusBadge(p.status)}</td>
    </tr>
  `).join('');
}

function renderVisitantes() {
  const tb = document.getElementById('visitantes-table');
  tb.innerHTML = visitors.map(v => `
    <tr>
      <td class="td-name">${v.nome}</td>
      <td>${v.doc}</td>
      <td>${v.destino}</td>
      <td>${v.resp}</td>
      <td>${v.entrada}</td>
      <td>${statusBadge(v.status)}</td>
      <td>
        <button class="filter-btn" style="padding:5px 10px;font-size:12px;" onclick="showToast('Saída registrada para ${v.nome}', 'success')">Registrar Saída</button>
      </td>
    </tr>
  `).join('');
}

function renderRecent() {
  const el = document.getElementById('recent-list');
  el.innerHTML = people.slice(0,4).map(p => `
    <div class="entry-item">
      <div class="entry-avatar">${p.nome[0]}</div>
      <div>
        <div class="entry-name">${p.nome}</div>
        <div class="entry-time">${p.entrada} · ${p.tipo}</div>
      </div>
      <div class="entry-badge">${statusBadge(p.status)}</div>
    </div>
  `).join('');
}

function renderChart() {
  const data = [52, 67, 45, 78, 83, 61, 74];
  const labels = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
  const max = Math.max(...data);
  const chart = document.getElementById('chart');
  const labelsEl = document.getElementById('chart-labels');
  chart.innerHTML = data.map((v, i) => `
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;">
      <div class="chart-bar ${i===6?'active':''}" style="height:${(v/max)*160}px;width:100%;background:${i===6?'var(--red-primary)':'var(--gray-300)'}"></div>
      <div class="chart-label">${v}</div>
    </div>
  `).join('');
  labelsEl.innerHTML = labels.map(l => `<span style="flex:1;text-align:center;font-size:11px;color:var(--gray-400)">${l}</span>`).join('');
}

// ─── CLOCK ───
function updateClock() {
  const now = new Date();
  document.getElementById('clock-time').textContent =
    now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  document.getElementById('clock-date').textContent =
    now.toLocaleDateString('pt-BR');
}
setInterval(updateClock, 1000);
updateClock();

// ─── NAVIGATION ───
function showView(name) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
  const titles = { dashboard: 'INÍCIO', acessos: 'ACESSOS', visitantes: 'VISITANTES', relatorios: 'RELATÓRIOS', configuracoes: 'CONFIGURAÇÕES' };
  document.getElementById('page-title').textContent = titles[name] || name.toUpperCase();
  event.currentTarget && event.currentTarget.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => {
    if (n.getAttribute('onclick') && n.getAttribute('onclick').includes(name)) n.classList.add('active');
  });
}

// ─── LOG FILTERS ───
document.querySelectorAll('.log-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    btn.closest('.log-filters').querySelectorAll('.log-filter').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

// ─── SETTINGS NAV ───
document.querySelectorAll('.settings-nav-item').forEach(item => {
  item.addEventListener('click', () => {
    document.querySelectorAll('.settings-nav-item').forEach(i => i.classList.remove('active'));
    item.classList.add('active');
  });
});

// ─── BIOMETRIC SCANNER ───
function triggerScan() {
  if (scanState === 'scanning') return;
  scanState = 'scanning';
  const scanner = document.getElementById('bio-scanner');
  const nameEl = document.getElementById('bio-name');
  const infoEl = document.getElementById('bio-info');

  scanner.className = 'bio-scanner scanning';
  nameEl.textContent = 'Lendo biometria...';
  infoEl.textContent = 'Aguarde o processamento';

  const deny = Math.random() < 0.15;

  setTimeout(() => {
    if (deny) {
      scanner.className = 'bio-scanner denied';
      nameEl.textContent = 'Acesso Negado';
      infoEl.textContent = 'Biometria não reconhecida';
      showToast('Acesso negado — biometria não cadastrada', 'error');
    } else {
      const person = scanNames[scanIdx % scanNames.length];
      scanIdx++;
      scanner.className = 'bio-scanner success';
      nameEl.textContent = person.nome;
      infoEl.textContent = person.info;
      showToast(`Acesso liberado — ${person.nome}`, 'success');
    }
    scanState = 'done';
    setTimeout(() => resetScanner(), 3000);
  }, 1800);
}

function resetScanner() {
  scanState = 'idle';
  const scanner = document.getElementById('bio-scanner');
  const nameEl = document.getElementById('bio-name');
  const infoEl = document.getElementById('bio-info');
  scanner.className = 'bio-scanner';
  nameEl.textContent = 'Aguardando leitura';
  infoEl.textContent = 'Posicione o dedo no sensor biométrico';
}

// ─── MODAL ───
function openModal() { document.getElementById('modal').classList.add('open'); }
function closeModal() { document.getElementById('modal').classList.remove('open'); }
function saveVisitor() {
  closeModal();
  showToast('Visitante cadastrado com sucesso!', 'success');
}

document.getElementById('modal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

// ─── TOAST ───
function showToast(msg, type = 'info') {
  const icons = {
    success: '<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>',
    error: '<svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    info: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
  };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = icons[type] + msg;
  document.getElementById('toasts').appendChild(toast);
  setTimeout(() => toast.remove(), 3500);
}

// ─── INIT ───
renderDashboard();
renderAcessos();
renderVisitantes();
renderRecent();
renderChart();
</script>
